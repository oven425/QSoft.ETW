<Window x:Class="WpfApp1.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:models="clr-namespace:WpfApp1.Models"
		xmlns:qpanel="clr-namespace:QSoft.WPF.Panel;assembly=QSoft.WPF.Panel"
		Title="ETW 資料表瀏覽器" Height="480" Width="640" MinHeight="600" MinWidth="800">
    <DockPanel Margin="8">
		<qpanel:FlexPanel AlignItems="Center" FlexDirection="Row" DockPanel.Dock="Top" Gap="6">
			<TextBlock Grid.Column="3" VerticalAlignment="Center" Text="追蹤秒數："/>
			<TextBox Width="100"  Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}"/>
			<Button Content="開始擷取並分析" Click="Capture_Click"/>
			<Button Content="分析既有檔案" Click="Analyze_Click"/>
			<Button Content="載入已分析 .db" Click="OpenDatabase_Click"/>
		</qpanel:FlexPanel>
		<qpanel:FlexPanel AlignItems="Center" FlexDirection="Row" DockPanel.Dock="Top" Gap="6">
			<TextBlock Text="ETL 檔案："/>
			<TextBox IsReadOnly="True" qpanel:FlexPanel.Grow="1" Text="{Binding EtlPath, UpdateSourceTrigger=PropertyChanged}"/>
		</qpanel:FlexPanel>
		<qpanel:FlexPanel AlignItems="Center" FlexDirection="Row" DockPanel.Dock="Top" Gap="6">
			<TextBlock Text="{Binding Status}"/>
			<TextBlock Foreground="Firebrick" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
		</qpanel:FlexPanel>

        <TabControl x:Name="tabcontrol">
            <TabItem Header="Process">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,6" Text="{Binding ProcessTreeStatus}" TextWrapping="Wrap"/>
                    <TreeView Grid.Row="1" ItemsSource="{Binding ProcessRoots}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:ProcessTreeNode}" ItemsSource="{Binding Children}">
                                <StackPanel Margin="0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding ImageFileName}"/>
                                        <TextBlock Margin="8,0,0,0" Text="{Binding ProcessId, StringFormat=PID: {0}}"/>
                                    </StackPanel>
                                    <TextBlock Foreground="DimGray" Text="{Binding CommandLine}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CommandLine}" Width="620"/>
                                    <TextBlock Foreground="DarkSlateGray" Text="{Binding MemorySummary}"/>
                                    <Expander Margin="12,2,0,0" Header="{Binding ImageSummary}">
                                        <ItemsControl ItemsSource="{Binding Images}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ProcessImage}">
                                                    <TextBlock Margin="8,1,0,1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" Width="600"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </TabItem>
            <TabItem Header="WMI">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,6" Text="{Binding WmiStatus}" TextWrapping="Wrap"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding WmiHotspots}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" Width="140"/>
                            <DataGridTextColumn Header="種類" Binding="{Binding Kind}" Width="70"/>
                            <DataGridTextColumn Header="Query / Class::Method" Binding="{Binding Target}" Width="260">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Target}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="120"/>
                            <DataGridTextColumn Header="呼叫次數" Binding="{Binding CallCount}" Width="70"/>
                            <DataGridTextColumn Header="呼叫Process數" Binding="{Binding CallerProcessCount}" Width="90"/>
                            <DataGridTextColumn Header="平均耗時(ms)" Binding="{Binding AverageDurationMs, StringFormat={}{0:N1}}" Width="90"/>
                            <DataGridTextColumn Header="最長耗時(ms)" Binding="{Binding MaxDurationMs, StringFormat={}{0:N1}}" Width="90"/>
                            <DataGridTextColumn Header="平均輪詢間隔(ms)" Binding="{Binding AverageIntervalMs, StringFormat={}{0:N0}}" Width="110"/>
                            <DataGridTextColumn Header="錯誤次數" Binding="{Binding ErrorCount}" Width="70"/>
                            <DataGridTextColumn Header="首次" Binding="{Binding FirstSeenUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="90"/>
                            <DataGridTextColumn Header="末次" Binding="{Binding LastSeenUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="90"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate DataType="{x:Type models:WmiSignatureNode}">
                                <DataGrid Margin="24,4,4,4" MaxHeight="220" ItemsSource="{Binding Callers}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserSortColumns="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="呼叫 Process" Binding="{Binding ProcessDisplayName}" Width="220"/>
                                        <DataGridTextColumn Header="呼叫次數" Binding="{Binding CallCount}" Width="70"/>
                                        <DataGridTextColumn Header="平均耗時(ms)" Binding="{Binding AverageDurationMs, StringFormat={}{0:N1}}" Width="90"/>
                                        <DataGridTextColumn Header="最長耗時(ms)" Binding="{Binding MaxDurationMs, StringFormat={}{0:N1}}" Width="90"/>
                                        <DataGridTextColumn Header="平均輪詢間隔(ms)" Binding="{Binding AverageIntervalMs, StringFormat={}{0:N0}}" Width="110"/>
                                        <DataGridTextColumn Header="錯誤次數" Binding="{Binding ErrorCount}" Width="70"/>
                                        <DataGridTextColumn Header="首次" Binding="{Binding FirstSeenUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="90"/>
                                        <DataGridTextColumn Header="末次" Binding="{Binding LastSeenUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Margin="0,8,0,4" FontWeight="SemiBold" Text="WMI 系統/提供者事件（Provider 載入失敗、主機錯誤等，常是資源消耗的根本原因）"/>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding WmiSystemEvents}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="時間" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="100"/>
                            <DataGridTextColumn Header="事件" Binding="{Binding EventLabel}" Width="140"/>
                            <DataGridTextColumn Header="來源" Binding="{Binding Source}" Width="220"/>
                            <DataGridTextColumn Header="結果碼" Binding="{Binding ResultCode}" Width="70"/>
                            <DataGridTextColumn Header="說明" Binding="{Binding Detail}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Detail}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
