<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:qpanel="clr-namespace:QSoft.WPF.Panel;assembly=QSoft.WPF.Panel"
		Title="ETW 資料表瀏覽器" Height="720" Width="1280" MinHeight="600" MinWidth="800">
    <DockPanel Margin="8">
		<qpanel:FlexPanel AlignItems="Center" FlexDirection="Row" DockPanel.Dock="Top" Gap="6">
			<TextBlock Grid.Column="3" VerticalAlignment="Center" Text="追蹤秒數："/>
			<TextBox Width="100"  Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}"/>
			<Button Content="開始擷取並分析" Click="Capture_Click"/>
			<Button Content="分析既有檔案" Click="Analyze_Click"/>
		</qpanel:FlexPanel>
		<qpanel:FlexPanel AlignItems="Center" FlexDirection="Row" DockPanel.Dock="Top" Gap="6">
			<TextBlock Text="ETL 檔案："/>
			<TextBox IsReadOnly="True" qpanel:FlexPanel.Grow="1" Text="{Binding EtlPath, UpdateSourceTrigger=PropertyChanged}"/>
		</qpanel:FlexPanel>
		<qpanel:FlexPanel AlignItems="Center" FlexDirection="Row" DockPanel.Dock="Top" Gap="6">
			<TextBlock Text="{Binding Status}"/>
			<TextBlock Foreground="Firebrick" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
		</qpanel:FlexPanel>

        <TabControl ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding DataContext.TableRows, RelativeSource={RelativeSource AncestorType=Window}}"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="首頁" Command="{Binding DataContext.GoToFirstPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanGoToFirstPage, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Content="上一頁" Margin="6,0,0,0" Command="{Binding DataContext.GoToPreviousPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanGoToPreviousPage, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBlock Margin="12,0" VerticalAlignment="Center" Text="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=第 {0} 頁}"/>
                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="{Binding DataContext.TotalPages, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=/ {0} 頁}"/>
                            <Button Content="下一頁" Command="{Binding DataContext.GoToNextPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanGoToNextPage, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Content="末頁" Margin="6,0,0,0" Command="{Binding DataContext.GoToLastPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanGoToLastPage, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding DataContext.TotalRowCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=共 {0:N0} 筆}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>