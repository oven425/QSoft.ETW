<Window x:Class="WpfApp1.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:models="clr-namespace:WpfApp1.Models"
		xmlns:qpanel="clr-namespace:QSoft.WPF.Panel;assembly=QSoft.WPF.Panel"
		Title="ETW 資料表瀏覽器" Height="480" Width="640" MinHeight="600" MinWidth="800">
    <DockPanel Margin="8">
		<qpanel:FlexPanel AlignItems="Center" FlexDirection="Row" DockPanel.Dock="Top" Gap="6">
			<TextBlock Grid.Column="3" VerticalAlignment="Center" Text="追蹤秒數："/>
			<TextBox Width="100"  Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}"/>
			<Button Content="開始擷取並分析" Click="Capture_Click"/>
			<Button Content="分析既有檔案" Click="Analyze_Click"/>
			<Button Content="載入已分析 .db" Click="OpenDatabase_Click"/>
		</qpanel:FlexPanel>
		<qpanel:FlexPanel AlignItems="Center" FlexDirection="Row" DockPanel.Dock="Top" Gap="6">
			<TextBlock Text="ETL 檔案："/>
			<TextBox IsReadOnly="True" qpanel:FlexPanel.Grow="1" Text="{Binding EtlPath, UpdateSourceTrigger=PropertyChanged}"/>
		</qpanel:FlexPanel>
		<qpanel:FlexPanel AlignItems="Center" FlexDirection="Row" DockPanel.Dock="Top" Gap="6">
			<TextBlock Text="{Binding Status}"/>
			<TextBlock Foreground="Firebrick" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
		</qpanel:FlexPanel>

        <TabControl x:Name="tabcontrol">
            <TabItem Header="Process">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,6" Text="{Binding ProcessTreeStatus}" TextWrapping="Wrap"/>
                    <TreeView Grid.Row="1" ItemsSource="{Binding ProcessRoots}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:ProcessTreeNode}" ItemsSource="{Binding Children}">
                                <StackPanel Margin="0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding ImageFileName}"/>
                                        <TextBlock Margin="8,0,0,0" Text="{Binding ProcessId, StringFormat=PID: {0}}"/>
                                    </StackPanel>
                                    <TextBlock Foreground="DimGray" Text="{Binding CommandLine}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CommandLine}" Width="620"/>
                                    <TextBlock Foreground="DarkSlateGray" Text="{Binding MemorySummary}"/>
                                    <Expander Margin="12,2,0,0" Header="{Binding ImageSummary}">
                                        <ItemsControl ItemsSource="{Binding Images}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ProcessImage}">
                                                    <TextBlock Margin="8,1,0,1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" Width="600"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </TabItem>
            <TabItem Header="WMI">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,6" Text="{Binding WmiStatus}" TextWrapping="Wrap"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding WmiHotspots}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" Width="140"/>
                            <DataGridTextColumn Header="種類" Binding="{Binding Kind}" Width="70"/>
                            <DataGridTextColumn Header="Query / Class::Method" Binding="{Binding Target}" Width="260">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Target}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="120"/>
                            <DataGridTextColumn Header="呼叫次數" Binding="{Binding CallCount}" Width="70"/>
                            <DataGridTextColumn Header="呼叫Process數" Binding="{Binding CallerProcessCount}" Width="90"/>
                            <DataGridTextColumn Header="平均耗時(ms)" Binding="{Binding AverageDurationMs, StringFormat={}{0:N1}}" Width="90"/>
                            <DataGridTextColumn Header="最長耗時(ms)" Binding="{Binding MaxDurationMs, StringFormat={}{0:N1}}" Width="90"/>
                            <DataGridTextColumn Header="平均輪詢間隔(ms)" Binding="{Binding AverageIntervalMs, StringFormat={}{0:N0}}" Width="110"/>
                            <DataGridTextColumn Header="錯誤次數" Binding="{Binding ErrorCount}" Width="70"/>
                            <DataGridTextColumn Header="首次" Binding="{Binding FirstSeenUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="90"/>
                            <DataGridTextColumn Header="末次" Binding="{Binding LastSeenUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="90"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate DataType="{x:Type models:WmiSignatureNode}">
                                <DataGrid Margin="24,4,4,4" MaxHeight="220" ItemsSource="{Binding Callers}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserSortColumns="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="呼叫 Process" Binding="{Binding ProcessDisplayName}" Width="220"/>
                                        <DataGridTextColumn Header="呼叫次數" Binding="{Binding CallCount}" Width="70"/>
                                        <DataGridTextColumn Header="平均耗時(ms)" Binding="{Binding AverageDurationMs, StringFormat={}{0:N1}}" Width="90"/>
                                        <DataGridTextColumn Header="最長耗時(ms)" Binding="{Binding MaxDurationMs, StringFormat={}{0:N1}}" Width="90"/>
                                        <DataGridTextColumn Header="平均輪詢間隔(ms)" Binding="{Binding AverageIntervalMs, StringFormat={}{0:N0}}" Width="110"/>
                                        <DataGridTextColumn Header="錯誤次數" Binding="{Binding ErrorCount}" Width="70"/>
                                        <DataGridTextColumn Header="首次" Binding="{Binding FirstSeenUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="90"/>
                                        <DataGridTextColumn Header="末次" Binding="{Binding LastSeenUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Margin="0,8,0,4" FontWeight="SemiBold" Text="WMI 系統/提供者事件（Provider 載入失敗、主機錯誤等，常是資源消耗的根本原因）"/>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding WmiSystemEvents}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="時間" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="100"/>
                            <DataGridTextColumn Header="事件" Binding="{Binding EventLabel}" Width="140"/>
                            <DataGridTextColumn Header="來源" Binding="{Binding Source}" Width="220"/>
                            <DataGridTextColumn Header="結果碼" Binding="{Binding ResultCode}" Width="70"/>
                            <DataGridTextColumn Header="說明" Binding="{Binding Detail}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Detail}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="DPC / UI 卡頓分析">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="{Binding DpcAnalysisStatus}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,4,0,0" Foreground="DimGray" Text="{Binding DpcInterpretationNote}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding DpcHotspots}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Routine" Binding="{Binding RoutineDisplay}" Width="130"/>
                            <DataGridTextColumn Header="模組 / Image" Binding="{Binding ModuleDisplay}" Width="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding ModulePath}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="事件數" Binding="{Binding EventCount}" Width="70"/>
                            <DataGridTextColumn Header="類型分布" Binding="{Binding DpcTypeSummary}" Width="180"/>
                            <DataGridTextColumn Header="Notable CPU" Binding="{Binding NotableCpu}" Width="110"/>
                            <DataGridTextColumn Header="CPU 分布" Binding="{Binding CpuDistribution}" Width="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding CpuDistribution}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="首次" Binding="{Binding FirstSeenUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="95"/>
                            <DataGridTextColumn Header="末次" Binding="{Binding LastSeenUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Margin="0,8,0,4" FontWeight="SemiBold"
                               Text="DPC 事件尖峰時間窗（僅代表事件在該時段集中，適合與 UI 卡頓/WMI/能耗時間點交叉比對，並非因果證明）"/>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding DpcSpikeWindows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="開始(UTC)" Binding="{Binding WindowStartUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="100"/>
                            <DataGridTextColumn Header="結束(UTC)" Binding="{Binding WindowEndUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="100"/>
                            <DataGridTextColumn Header="事件數" Binding="{Binding EventCount}" Width="70"/>
                            <DataGridTextColumn Header="類型分布" Binding="{Binding DpcTypeSummary}" Width="180"/>
                            <DataGridTextColumn Header="Notable CPU" Binding="{Binding NotableCpu}" Width="110"/>
                            <DataGridTextColumn Header="尖峰判定" Binding="{Binding ThresholdDisplay}" Width="220"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate DataType="{x:Type models:DpcSpikeWindow}">
                                <DataGrid Margin="24,4,4,4" MaxHeight="220" ItemsSource="{Binding TopRoutines}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserSortColumns="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Routine" Binding="{Binding RoutineDisplay}" Width="130"/>
                                        <DataGridTextColumn Header="模組 / Image" Binding="{Binding ModuleDisplay}" Width="220">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="ToolTip" Value="{Binding ModulePath}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="事件數" Binding="{Binding EventCount}" Width="70"/>
                                        <DataGridTextColumn Header="類型分布" Binding="{Binding DpcTypeSummary}" Width="180"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="能耗分析">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,6" Text="{Binding EnergyConsumerStatus}" TextWrapping="Wrap"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding EnergyConsumers}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名稱" Binding="{Binding AppName}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding AppName}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="分類" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="總估算能耗" Binding="{Binding TotalEnergy, StringFormat={}{0:N0}}" Width="100"/>
                            <DataGridTextColumn Header="CPU" Binding="{Binding TotalCpuEnergy, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="GPU" Binding="{Binding TotalGpuEnergy, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="Display" Binding="{Binding TotalDisplayEnergy, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="Disk" Binding="{Binding TotalDiskEnergy, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="Network" Binding="{Binding TotalNetworkEnergy, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="MBB" Binding="{Binding TotalMbbEnergy, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="NPU" Binding="{Binding TotalNpuEnergy, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="Loss" Binding="{Binding TotalLossEnergy, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="事件數" Binding="{Binding EventCount}" Width="70"/>
                            <DataGridTextColumn Header="實測比例" Binding="{Binding MeasuredRatio, StringFormat={}{0:P0}}" Width="80"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate DataType="{x:Type models:EnergyConsumerSummary}">
                                <StackPanel Margin="24,4,4,4">
                                    <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" FontStyle="Italic"
                                               Text="Display 能耗成因分解：依前景/可見/最小化狀態拆解。若能耗集中在 Focus/Visible 且螢幕開啟比例接近 100%，代表主因是「畫面長時間顯示」的正常時間成本；若 Minimized 狀態下仍有能耗，可能是背景阻止螢幕休眠或視窗殘留可見狀態的異常，值得深查。"/>
                                    <DataGrid ItemsSource="{Binding InteractivityBreakdown}" MaxHeight="200" AutoGenerateColumns="False"
                                              IsReadOnly="True" CanUserSortColumns="True" CanUserAddRows="False"
                                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="互動狀態" Binding="{Binding InteractivityState}" Width="150"/>
                                            <DataGridTextColumn Header="事件數" Binding="{Binding EventCount}" Width="70"/>
                                            <DataGridTextColumn Header="總時長(ms)" Binding="{Binding TotalTimeInMSec, StringFormat={}{0:N0}}" Width="100"/>
                                            <DataGridTextColumn Header="Display能耗" Binding="{Binding TotalDisplayEnergy, StringFormat={}{0:N0}}" Width="100"/>
                                            <DataGridTextColumn Header="CPU能耗" Binding="{Binding TotalCpuEnergy, StringFormat={}{0:N0}}" Width="90"/>
                                            <DataGridTextColumn Header="GPU能耗" Binding="{Binding TotalGpuEnergy, StringFormat={}{0:N0}}" Width="90"/>
                                            <DataGridTextColumn Header="螢幕開啟比例" Binding="{Binding MonitorOnRatio, StringFormat={}{0:P0}}" Width="95"/>
                                            <DataGridTextColumn Header="前景比例" Binding="{Binding ForegroundRatio, StringFormat={}{0:P0}}" Width="80"/>
                                            <DataGridTextColumn Header="Display實測比例" Binding="{Binding DisplayMeasuredRatio, StringFormat={}{0:P0}}" Width="105"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Margin="0,8,0,4" Text="{Binding EnergyAccuracyStatus}" TextWrapping="Wrap"/>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding EnergyAccuracyMeters}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="電表 MeterId" Binding="{Binding MeterId}" Width="140"/>
                            <DataGridTextColumn Header="區間數" Binding="{Binding BucketCount}" Width="70"/>
                            <DataGridTextColumn Header="E3 估算總量" Binding="{Binding TotalEstimatedEnergy, StringFormat={}{0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="電表實測總量" Binding="{Binding TotalMeasuredEnergyDelta, StringFormat={}{0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="平均比值" Binding="{Binding AverageRatio, StringFormat={}{0:N4}}" Width="90"/>
                            <DataGridTextColumn Header="相關係數" Binding="{Binding CorrelationCoefficient, StringFormat={}{0:N2}}" Width="90"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate DataType="{x:Type models:EnergyAccuracyMeterSummary}">
                                <DataGrid Margin="24,4,4,4" MaxHeight="220" ItemsSource="{Binding Buckets}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserSortColumns="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="分鐘區間(UTC)" Binding="{Binding BucketStartUtc, StringFormat={}{0:HH:mm}}" Width="100"/>
                                        <DataGridTextColumn Header="E3 估算" Binding="{Binding EstimatedEnergy, StringFormat={}{0:N0}}" Width="120"/>
                                        <DataGridTextColumn Header="電表實測差值" Binding="{Binding MeasuredEnergyDelta, StringFormat={}{0:N0}}" Width="120"/>
                                        <DataGridTextColumn Header="比值" Binding="{Binding Ratio, StringFormat={}{0:N4}}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
